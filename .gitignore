# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/output/
/.playwright-cli/
/build-resources/icon.iconset/
/.vinext/
/.wrangler/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment files are never part of this app's credential flow
.env*
/dist/
dist-electron/
release/
*.dmg
*.blockmap
*.map
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal
